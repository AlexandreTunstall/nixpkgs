diff --git a/lib/Data/Foldable.hs b/lib/Data/Foldable.hs
index 59e94e0b..45e7220c 100644
--- a/lib/Data/Foldable.hs
+++ b/lib/Data/Foldable.hs
@@ -54,7 +54,6 @@ import Data.Function
 import Data.Functor.Const
 import Data.Functor.Identity
 import Data.List_Type hiding (concatMap)
-import qualified Data.List as List
 import Data.Maybe
 import Data.Monoid
 import Data.Monoid.Internal hiding (Max(..), Min(..))
@@ -146,22 +145,49 @@ instance Foldable Maybe where
     foldl f z (Just x) = f z x
 
 instance Foldable [] where
-    elem    = List.elem
-    foldl   = List.foldl
-    foldl'  = List.foldl'
-    foldl1  = List.foldl1
-    foldr   = List.foldr
-    --foldr'  = List.foldr'
-    foldr1  = List.foldr1
-    foldMap = (mconcat .) . List.map
-    fold    = mconcat
-    length  = List.length
-    maximum = List.maximum
-    minimum = List.minimum
-    null    = List.null
-    product = List.product
-    sum     = List.sum
-    toList  = id
+    elem a = any (a ==)
+
+    foldl _ z [] = z
+    foldl f z (x : xs) = foldl f (f z x) xs
+
+    foldl' _ z [] = z
+    foldl' f z (x : xs) =
+      let y = f z x
+      in  y `seq` foldl' f y xs
+
+    foldl1 _ [] = error "foldl1: empty list"
+    foldl1 f (x : xs) = foldl f x xs
+
+    foldr _ z [] = z
+    foldr f z (x : xs) = f x (foldr f z xs)
+
+    foldr1 _ [] = error "foldr1: empty list"
+    foldr1 _ [x] = x
+    foldr1 f (x : xs) = f x (foldr1 f xs)
+
+    fold = mconcat
+
+    length =
+      -- Make it tail recursive and strict
+      let
+        rec r [] = r
+        rec r (_:xs) =
+              let r' = r + (1::Int)
+              in  r' `primSeq` rec r' xs
+      in rec (0::Int)
+
+    maximum [] = error "maximum: empty list"
+    maximum (x:ys) = foldr (\ y m -> if y > m then y else m) x ys
+
+    minimum [] = error "minimum: empty list"
+    minimum (x:ys) = foldr (\ y m -> if y < m then y else m) x ys
+
+    null [] = True
+    null _  = False
+
+    product = foldr (*) 1
+    sum = foldr (+) 0
+    toList = id
 
 instance Foldable (Either a) where
     foldMap _ (Left _) = mempty
