+elem = coerce B.elem
+
+notElem :: Word8 -> ShortByteString -> Bool
+notElem = coerce B.notElem
+
+filter :: (Word8 -> Bool) -> ShortByteString -> ShortByteString
+filter = coerce B.filter
+
+find :: (Word8 -> Bool) -> ShortByteString -> Maybe Word8
+find = coerce B.find
+
+partition :: (Word8 -> Bool) -> ShortByteString -> (ShortByteString, ShortByteString)
+partition = coerce B.partition
+
+isPrefixOf :: ShortByteString -> ShortByteString -> Bool
+isPrefixOf = coerce B.isPrefixOf
+
+stripPrefix :: ShortByteString -> ShortByteString -> Maybe ShortByteString
+stripPrefix = coerce B.stripPrefix
+
+isSuffixOf :: ShortByteString -> ShortByteString -> Bool
+isSuffixOf = coerce B.isSuffixOf
+
+stripSuffix :: ShortByteString -> ShortByteString -> Maybe ShortByteString
+stripSuffix = coerce B.stripSuffix
+
+isInfixOf :: ShortByteString -> ShortByteString -> Bool
+isInfixOf = coerce B.isInfixOf
+
+isValidUtf8 :: ShortByteString -> Bool
+isValidUtf8 = coerce B.isValidUtf8
+
+breakSubstring :: ShortByteString -> ShortByteString -> (ShortByteString,ShortByteString)
+breakSubstring = coerce B.breakSubstring
+
+zip :: ShortByteString -> ShortByteString -> [(Word8,Word8)]
+zip = coerce B.zip
+
+zipWith :: (Word8 -> Word8 -> a) -> ShortByteString -> ShortByteString -> [a]
+zipWith f x y = B.zipWith (coerce f) (coerce x) (coerce y)
+
+packZipWith :: (Word8 -> Word8 -> Word8) -> ShortByteString -> ShortByteString -> ShortByteString
+packZipWith = coerce B.packZipWith
+
+unzip :: [(Word8,Word8)] -> (ShortByteString,ShortByteString)
+unzip = coerce B.unzip
+
