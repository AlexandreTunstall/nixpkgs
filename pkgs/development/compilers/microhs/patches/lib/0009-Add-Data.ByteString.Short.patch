+module Data.ByteString.Short(module Data.ByteString.Short) where
+import qualified Data.ByteString as B
+import Data.Coerce
+import Data.List.NonEmpty
+import Data.Word(Word8)
+import Foreign.C.String (CString, CStringLen)
+import System.IO(Handle)
+
+newtype ShortByteString = BS { fromShort :: B.ByteString }
+  deriving (Eq, Ord)
+
+instance Show ShortByteString where
+  showsPrec p (BS bs) = showsPrec p bs
+
+instance IsString ShortByteString where
+  fromString = BS . fromString
+
+instance Semigroup ShortByteString where
+  BS a <> BS b = BS (a <> b)
+
+instance Monoid ShortByteString where
+  mempty = BS mempty
+
+toShort :: B.ByteString -> ShortByteString
+toShort = BS
+
+empty :: ShortByteString
+empty = coerce B.empty
+
+singleton :: Word8 -> ShortByteString
+singleton = coerce B.singleton
+
+pack :: [Word8] -> ShortByteString
+pack = coerce B.pack
+
+unpack :: ShortByteString -> [Word8]
+unpack = coerce B.unpack
+
+cons :: Word8 -> ShortByteString -> ShortByteString
+cons = coerce B.cons
+
+snoc :: ShortByteString -> Word8 -> ShortByteString
+snoc = coerce B.snoc
+
+append :: ShortByteString -> ShortByteString -> ShortByteString
+append = coerce B.append
+
+head :: ShortByteString -> Word8
+head = coerce B.head
+
+tail :: ShortByteString -> ShortByteString
+tail = coerce B.tail
+
+length :: ShortByteString -> Int
+length = coerce B.length
+
+uncons :: ShortByteString -> Maybe (Word8, ShortByteString)
+uncons = coerce B.uncons
+
+last :: ShortByteString -> Word8
+last = coerce B.last
+
+init :: ShortByteString -> ShortByteString
+init = coerce B.init
+
+unsnoc :: ShortByteString -> Maybe (ShortByteString, Word8)
+unsnoc = coerce B.unsnoc
+
+null :: ShortByteString -> Bool
+null = coerce B.null
+
+map :: (Word8 -> Word8) -> ShortByteString -> ShortByteString
+map = coerce B.map
+
+reverse :: ShortByteString -> ShortByteString
+reverse = coerce B.reverse
+
+intersperse :: Word8 -> ShortByteString -> ShortByteString
+intersperse = coerce B.intersperse
+
+transpose :: [ShortByteString] -> [ShortByteString]
+transpose = coerce B.transpose
+
+foldl :: (a -> Word8 -> a) -> a -> ShortByteString -> a
+foldl f z x = B.foldl (coerce f) z (coerce x)
+
+foldl' :: (a -> Word8 -> a) -> a -> ShortByteString -> a
+foldl' f z x = B.foldl' (coerce f) z (coerce x)
+
+foldr :: (Word8 -> a -> a) -> a -> ShortByteString -> a
+foldr f z x = B.foldr (coerce f) z (coerce x)
+
+foldr' :: (Word8 -> a -> a) -> a -> ShortByteString -> a
+foldr' f z x = B.foldr' (coerce f) z (coerce x)
+
+foldl1 :: (Word8 -> Word8 -> Word8) -> ShortByteString -> Word8
+foldl1 = coerce B.foldl1
+
+foldl1' :: (Word8 -> Word8 -> Word8) -> ShortByteString -> Word8
+foldl1' = coerce B.foldl1'
+
+foldr1 :: (Word8 -> Word8 -> Word8) -> ShortByteString -> Word8
+foldr1 = coerce B.foldr1
+
+foldr1' :: (Word8 -> Word8 -> Word8) -> ShortByteString -> Word8
+foldr1' = coerce B.foldr1'
+
+concat :: [ShortByteString] -> ShortByteString
+concat = coerce B.concat
+
+concatMap :: (Word8 -> ShortByteString) -> ShortByteString -> ShortByteString
+concatMap = coerce B.concatMap
+
+any :: (Word8 -> Bool) -> ShortByteString -> Bool
+any = coerce B.any
+
+all :: (Word8 -> Bool) -> ShortByteString -> Bool
+all = coerce B.all
+
+maximum :: ShortByteString -> Word8
+maximum = coerce B.maximum
+
+minimum :: ShortByteString -> Word8
+minimum = coerce B.minimum
+
+mapAccumL :: (acc -> Word8 -> (acc, Word8)) -> acc -> ShortByteString -> (acc, ShortByteString)
+mapAccumL f s x = coerce (B.mapAccumL (coerce f) s (coerce x))
+
+mapAccumR :: (acc -> Word8 -> (acc, Word8)) -> acc -> ShortByteString -> (acc, ShortByteString)
+mapAccumR f s x = coerce (B.mapAccumR (coerce f) s (coerce x))
+
+scanl1 :: (Word8 -> Word8 -> Word8) -> ShortByteString -> ShortByteString
+scanl1 = coerce B.scanl1
+
+scanr1 :: (Word8 -> Word8 -> Word8) -> ShortByteString -> ShortByteString
+scanr1 = coerce B.scanr1
+
+replicate :: Int -> Word8 -> ShortByteString
+replicate = coerce B.replicate
+
+unfoldr :: (a -> Maybe (Word8, a)) -> a -> ShortByteString
+unfoldr f a = coerce (B.unfoldr (coerce f) a)
+
+unfoldrN :: Int -> (a -> Maybe (Word8, a)) -> a -> (ShortByteString, Maybe a)
+unfoldrN n f a = coerce (B.unfoldrN n (coerce f) a)
+
+take :: Int -> ShortByteString -> ShortByteString
+take = coerce B.take
+
+takeEnd :: Int -> ShortByteString -> ShortByteString
+takeEnd = coerce B.takeEnd
+
+drop  :: Int -> ShortByteString -> ShortByteString
+drop = coerce B.drop
+
+dropEnd :: Int -> ShortByteString -> ShortByteString
+dropEnd = coerce B.dropEnd
+
+splitAt :: Int -> ShortByteString -> (ShortByteString, ShortByteString)
+splitAt = coerce B.splitAt
+
+takeWhile :: (Word8 -> Bool) -> ShortByteString -> ShortByteString
+takeWhile = coerce B.takeWhile
+
+takeWhileEnd :: (Word8 -> Bool) -> ShortByteString -> ShortByteString
+takeWhileEnd = coerce B.takeWhileEnd
+
+dropWhile :: (Word8 -> Bool) -> ShortByteString -> ShortByteString
+dropWhile = coerce B.dropWhile
+
+dropWhileEnd :: (Word8 -> Bool) -> ShortByteString -> ShortByteString
+dropWhileEnd = coerce B.dropWhileEnd
+
+break :: (Word8 -> Bool) -> ShortByteString -> (ShortByteString, ShortByteString)
+break = coerce B.break
+
+breakEnd :: (Word8 -> Bool) -> ShortByteString -> (ShortByteString, ShortByteString)
+breakEnd = coerce B.breakEnd
+
+span :: (Word8 -> Bool) -> ShortByteString -> (ShortByteString, ShortByteString)
+span = coerce B.span
+
+spanEnd :: (Word8 -> Bool) -> ShortByteString -> (ShortByteString, ShortByteString)
+spanEnd = coerce B.spanEnd
+
+splitWith :: (Word8 -> Bool) -> ShortByteString -> [ShortByteString]
+splitWith = coerce B.splitWith
+
+split :: Word8 -> ShortByteString -> [ShortByteString]
+split = coerce B.split
+
+group :: ShortByteString -> [ShortByteString]
+group = coerce B.group
+
+groupBy :: (Word8 -> Word8 -> Bool) -> ShortByteString -> [ShortByteString]
+groupBy = coerce B.groupBy
+
+intercalate :: ShortByteString -> [ShortByteString] -> ShortByteString
+intercalate = coerce B.intercalate
+
+index :: ShortByteString -> Int -> Word8
+index = coerce B.index
+
+indexMaybe :: ShortByteString -> Int -> Maybe Word8
+indexMaybe = coerce B.indexMaybe
+
+(!?) :: ShortByteString -> Int -> Maybe Word8
